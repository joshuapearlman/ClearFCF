{
  "version": 2,
  "functions": {
    "api/analyze.js": { "maxDuration": 60 },
    "api/screen.js": { "maxDuration": 60 },
    "api/universe.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/audit.css", "destination": "/public/audit.css" },
    { "source": "/favicon.svg", "destination": "/public/favicon.svg" },
    { "source": "/favicon.png", "destination": "/public/favicon.png" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/apple-touch-icon.png", "destination": "/public/apple-touch-icon.png" },
    { "source": "/logo.svg", "destination": "/public/logo.svg" }
  ]
}