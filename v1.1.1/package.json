{
  "name": "clear-fcf-screener",
  "version": "1.1.1",
  "private": true,
  "description": "Transparent normalized free-cash-flow stock screener for Vercel",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dcf": "node dcf-server.js",
    "app": "electron electron-main.js",
    "build:mac": "electron-builder --mac",
    "publish:mac": "electron-builder --mac --publish always",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@openai/codex": "^0.147.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clearfcf.screener",
    "productName": "ClearFCF",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon-mark.png"
    },
    "publish": {
      "provider": "github",
      "owner": "joshuapearlman",
      "repo": "ClearFCF",
      "releaseType": "release"
    },
    "files": [
      "api/**/*",
      "lib/**/*",
      "public/**/*",
      "desktop-server.js",
      "electron-main.js",
      "preload.js",
      "server.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    }
  }
}
