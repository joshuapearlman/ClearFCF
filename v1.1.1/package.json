{
  "name": "clear-fcf-screener",
  "version": "1.2.0",
  "private": true,
  "description": "Transparent normalized free-cash-flow stock screener for Vercel",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dcf": "node dcf-server.js",
    "app": "electron electron-main.js",
    "build:mac": "node scripts/check-mac-deps.cjs && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@openai/codex": "^0.147.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.clearfcf.screener",
    "productName": "ClearFCF",
    "mac": {
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": ["dmg"],
      "icon": "public/icon-mark.png"
    },
    "files": [
      "api/**/*",
      "lib/**/*",
      "public/**/*",
      "desktop-server.js",
      "electron-main.js",
      "preload.js",
      "server.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    }
  }
}
